{
  "name": "metermydata",
  "version": "0.1.3",
  "description": "Free, local-only meter that shows how much of the data you received was a repeat.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "metermydata": "dist/cli.js"
  },
  "files": [
    "dist/",
    "providers.json",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/engine.test.mjs test/engine-edge.test.mjs test/share.test.mjs test/forwarder.test.mjs test/forwarder-hard.test.mjs test/forwarder-ux.test.mjs test/cli.test.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "homepage": "https://metermydata.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjk1988/metermydata-public"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "data",
    "metering",
    "duplicate",
    "repeat",
    "api",
    "egress",
    "har",
    "proxy"
  ],
  "author": "Atreius Enterprises <brad.kavin@atreius.com>"
}
